.tmp-*/
.tmp/
*.tmp/

# Incoming asset bundle — superseded by photos-src/ + src/content/photos.json.
# Kept out of the public repo on purpose: it contains optional/ extras and
# optional-has-people/ shots of identifiable people who have not consented.
photos-for-pile/

# Full-resolution source images. public/assets/me keeps only the optimised
# avif/webp/jpg variants the site actually serves; these 30 MB of intermediates
# are never requested by the browser and are re-derivable from the originals.
public/assets/me/portrait.png
public/assets/me/racing.png
public/assets/me/portrait_src.png
public/assets/me/racing_src.png
public/assets/me/clean_Gemini_*.png


# Local font download cache (scripts/og-generate.mjs re-fetches it)
/scripts/.fonts/

# OS / editor swap files
*.swp
*.swo
*~

.vercel
.env*
!.env.example
